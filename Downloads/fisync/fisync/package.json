{
  "name": "fisync",
  "version": "1.0.0",
  "description": "Control your computer from your phone and move files between devices over your local network",
  "author": "fisync",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fisync.app",
    "productName": "fisync",
    "files": ["**/*", "!android-app/**", "!.github/**", "!dist/**", "!README.md"],
    "asarUnpack": ["**/*.node"],
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage", "category": "Utility" }
  }
}
